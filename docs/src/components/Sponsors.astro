---
// Sponsors wall and support links.
import Glyph from './Glyph.astro';

const image = 'https://readme-contribs.as93.net/sponsors/vic?avatarSize=56&perRow=10&margin=12&textColor=9399b2&outlineWidth=0';
---

<div class="sponsors not-content">
	<a class="wall" href="https://github.com/sponsors/vic" aria-label="Sponsors on GitHub">
		<img src={image} alt="Avatars of the people and companies who sponsor vic on GitHub" loading="lazy" />
	</a>
	<div class="ways">
		<div class="way">
			<h3>Become a sponsor</h3>
			<p>Sponsoring pays for compute, hardware, and focus on Yen and open-source Nix tools. Thank you for making this work possible.</p>
			<a class="primary" href="https://github.com/sponsors/vic"><Glyph name="heart" size="1.1rem" />Sponsor on GitHub</a>
		</div>
		<div class="way">
			<h3>Build your own fleet with Yen</h3>
			<p>Initialize a minimal NixOS and Home Manager starter fleet in seconds, then borrow any pattern you like from Vix.</p>
			<a class="ghost" href="https://yen.oeiuwq.com/start/getting-started/"><Glyph name="chat" size="1.1rem" />Start with Yen</a>
		</div>
	</div>
</div>

<style>
	.sponsors {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.wall {
		display: flex;
		justify-content: center;
		padding: 1.5rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.875rem;
		background: color-mix(in srgb, var(--sl-color-accent) 4%, var(--sl-color-bg));
	}

	.wall img {
		width: 100%;
		max-width: 44rem;
		height: auto;
	}

	.ways {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media (min-width: 40rem) {
		.ways {
			grid-template-columns: 1fr 1fr;
		}
	}

	.way {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.875rem;
	}

	h3 {
		margin: 0;
		font-family: var(--font-victor-mono);
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	p {
		margin: 0;
		flex: 1;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--sl-color-gray-2);
	}

	a.primary,
	a.ghost {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 1.2rem;
		border-radius: 999px;
		font-family: var(--font-victor-mono);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			box-shadow 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.primary {
		color: var(--sl-color-black);
		background: linear-gradient(110deg, var(--yen-cyan), var(--sl-color-accent));
	}

	.primary:hover {
		color: var(--sl-color-black);
		box-shadow: 0 10px 26px -10px color-mix(in srgb, var(--sl-color-accent) 85%, transparent);
	}

	.ghost {
		color: var(--sl-color-white);
		border: 1px solid var(--sl-color-hairline-light);
	}

	.ghost:hover {
		color: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent);
	}
</style>
