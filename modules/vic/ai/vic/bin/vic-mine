#!/usr/bin/env bash
# vic-mine <rg-pattern> [max] — search THIS project's PAST SESSION TRANSCRIPTS (prior generations).
# Knowledge is constructed: prior session likely ran it / solved it / killed it. GLOBAL.
p=${1:?usage: vic-mine <pattern> [max-snippets]}
m=${2:-6}
k=$(printf '%s' "${CLAUDE_PROJECT_DIR:-$PWD}" | sed 's|/|-|g')
d="$HOME/.claude/projects/$k"
[ -d "$d" ] || { echo "no transcripts for $k"; exit 0; }
echo "── generations w/ matches:"
rg -lc -i "$p" "$d"/*.jsonl 2>/dev/null | tail -n 8
echo "── snippets (newest files last):"
rg -o -i --no-filename ".{0,120}${p}.{0,280}" "$d"/*.jsonl 2>/dev/null | awk '!seen[$0]++' | tail -n "$m" | cut -c1-500
echo "── deep-dive: dispatch vic-reader on the matching .jsonl (NEVER inline — huge)"
