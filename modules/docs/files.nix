# files: a class for repo files generated by sini/files; the writer joins the packages channel, each file gets a check.
{
  ren,
  inputs,
  ...
}:
{
  ren.classes.files = {
    at = ren.system.x86_64-linux;
    into =
      { system, ... }:
      ms:
      let
        e = inputs.nixpkgs.lib.evalModules {
          specialArgs.pkgs = system.legacyPackages;
          modules = [
            inputs.files.module
            { config.files.root = inputs.self; }
          ]
          ++ ms;
        };
      in
      {
        packages.write-files = e.config.files.writer.drv; # a channel emission
        checks.${system.name} = e.config.files.checks;
      };
  };

  ren.aspects.files-inputs = {
    at = ren.fleet.vix;
    flake-inputs = { ... }: {
      files.url = "github:sini/files/b79ab01ba5394ddf3c1d0fadafbcc1ccb9536c5f";
    };
  };
}
