# CI workflow: .github/workflows/ci.yml generated from the ci-jobs and checks channels (one matrix job per runner).
{ ren, inputs, ... }:
let
  yaml = import ./_yaml.nix;
  runners = import ./_runners.nix;
  self = inputs.self;
  checks = builtins.concatLists (
    builtins.attrValues (
      builtins.mapAttrs (
        system: cs:
        map (n: {
          name = "check-${n}-${system}";
          attr = "checks.${system}.\"${n}\"";
          inherit system;
          runner = runners.${system};
          allowFailure = false;
        }) (builtins.attrNames cs)
      ) self.checks
    )
  );
  # generated files (README, ci.yml) are checked on every PR event, so they are never stale
  isFiles = j: builtins.match "check-files/.*" j.name != null;
  files = builtins.filter isFiles checks;
  gated = self.ci.matrix ++ builtins.filter (j: !isFiles j) checks;
  setup = [
    {
      uses = "actions/checkout@v6";
    }
    {
      uses = "DeterminateSystems/determinate-nix-action@v3";
    }
    {
      uses = "DeterminateSystems/magic-nix-cache-action@v13";
    }
    {
      uses = "cachix/cachix-action@v17";
      "with" = {
        name = "vix";
        authToken = "\${{ secrets.CACHIX_AUTH_TOKEN }}";
      };
    }
  ];
  # the runner quota is small: PRs build only once approved or labeled `ci` (an author cannot approve their own PR)
  gate = builtins.concatStringsSep " || " [
    "github.event_name == 'push'"
    "github.event_name == 'workflow_dispatch'"
    "github.event.review.state == 'approved'"
    "github.event.label.name == 'ci'"
    "(github.event.action == 'synchronize' && contains(github.event.pull_request.labels.*.name, 'ci'))"
  ];
  job = cond: runner: include: {
    name = "build \${{ matrix.name }}";
    "if" = cond;
    runs-on = runner;
    continue-on-error = "\${{ matrix.allowFailure }}";
    strategy = {
      fail-fast = false;
      matrix.include = include;
    };
    steps =
      (
        if runner == "ubuntu-latest" then
          [
            { uses = "wimpysworld/nothing-but-nix@v10"; }
          ]
        else
          [ ]
      )
      ++ setup
      ++ [
        { run = "nix build --print-build-logs --out-link result '.#\${{ matrix.attr }}'"; }
        { run = "echo \"<code>$(readlink -f result)</code>\" >> \"$GITHUB_STEP_SUMMARY\""; }
      ];
  };
  workflow = {
    name = "ci";
    on = {
      workflow_dispatch = { };
      pull_request.types = [
        "opened"
        "reopened"
        "labeled"
        "synchronize"
      ];
      pull_request_review.types = [ "submitted" ];
      push.branches = [ "ren" ];
    };
    concurrency = {
      group = "\${{ github.workflow }}-\${{ github.ref }}";
      cancel-in-progress = true;
    };
    permissions.contents = "read";
    jobs =
      builtins.listToAttrs (
        builtins.attrValues (
          builtins.mapAttrs (r: include: {
            name = "build-${builtins.replaceStrings [ "." ] [ "_" ] r}";
            value = job gate r include;
          }) (builtins.groupBy (j: j.runner) gated)
        )
      )
      // {
        build-files = job "true" runners.x86_64-linux files;
      };
  };
in
{
  ren.aspects.ci-workflow = {
    at = ren.system.x86_64-linux;
    files.files.file.".github/workflows/ci.yml".text =
      "# generated by modules/features/ci-workflow.nix: nix run .#write-files\n" + yaml workflow;
  };
}
