# flake-inputs: each aspect declares the inputs it uses; the flake-file class writes flake.nix from them.
{
  ren,
  inputs,
  pkgsFor,
  ...
}:
{
  # channel `into` may not forward to a class (Ren D7): it writes the `flake-inputs` output, the class reads it.
  ren.channels.flake-inputs = {
    fold = ren.lib.fold.attrs;
    to = _: ren.fleet.vix; # no `at`: any scope emits
    into = { ... }: i: { flake-inputs = i; };
  };

  ren.classes.flake-file = {
    at = ren.system.x86_64-linux; # its packages and checks are channel emissions at a system
    into =
      { system, outputs, ... }:
      ms:
      let
        pkgs = pkgsFor system;
        e = inputs.nixpkgs.lib.evalModules {
          specialArgs = { inherit inputs; }; # write-flake.nix reads `top.inputs.self`: only specialArgs reach `@top`
          modules = [
            inputs.flake-file.flakeModules.flake
            { flake-file.inputs = outputs.flake-inputs; }
          ]
          ++ ms;
        };
        app = n: e.config.flake-file.apps.${n} pkgs;
      in
      {
        packages = {
          write-flake = app "write-flake";
          write-lock = app "write-lock";
        };
        checks.${system.name}.flake-file = e.config.flake-file.check-flake-file pkgs;
      };
  };

  ren.aspects.vix-flake = {
    at = ren.system.x86_64-linux;
    flake-file.flake-file = {
      description = "Vic's Nix Environment, powered by Ren";
      nixConfig = {
        extra-trusted-public-keys = [ "vix.cachix.org-1:hP/Lpdsi1dB3AxK9o6coWh+xHzvAc4ztdDYuG7lC6dI=" ];
        extra-substituters = [ "https://vix.cachix.org" ];
      };
      outputs = "inputs: inputs.ren.lib.mkFlake inputs (inputs.import-tree ./modules)";
      do-not-edit = ''
        # DO-NOT-EDIT. Generated by github:vic/flake-file from `flake-inputs` emissions in modules/.
        # Regenerate: nix build .#write-flake && ./result/bin/write-flake
      '';
    };
    flake-inputs =
      { ... }:
      {
        ren.url = "github:vic/ren";
        import-tree.url = "github:vic/import-tree/eb1b52eaecc57f7c136d07ae8a93e724dfecac46";
        flake-file.url = "github:vic/flake-file/d3600508b0b031221459f7358ab88c438a81ac83";
        # unused: candidate to drop
        devshell = {
          url = "github:numtide/devshell/9e29c63dde99a2d80c94b3d024c9768c01544558";
          inputs.nixpkgs.follows = "nixpkgs";
        };
        # unused: candidate to drop
        nix-unit = {
          url = "github:nix-community/nix-unit/b3d16367c54621fd073aa8c1dd510042f771f624";
          inputs.nix-github-actions.follows = "nix-github-actions";
          inputs.nixpkgs.follows = "nixpkgs";
          inputs.treefmt-nix.follows = "treefmt-nix";
        };
        # unused: candidate to drop (only nix-unit follows it)
        nix-github-actions = {
          url = "github:nix-community/nix-github-actions/f4158fa080ef4503c8f4c820967d946c2af31ec9";
          inputs.nixpkgs.follows = "nixpkgs";
        };
        # unused: candidate to drop (no input follows `utils`)
        utils.url = "github:numtide/flake-utils/04c1b180862888302ddfb2e3ad9eaa63afc60cf8";
      };
  };
}
