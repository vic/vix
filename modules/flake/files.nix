# files: a sink for repo files generated by sini/files; it gives the writer package and one check per file.
{ yen, inputs, ... }:
let
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
in
{
  # on the root: the docs aspects reach it from any scope
  yen.kinds.fleet.sinks.files.out =
    { files, ... }:
    let
      e = inputs.nixpkgs.lib.evalModules {
        specialArgs.pkgs = pkgs;
        modules = [
          inputs.files.module
          { config.files.root = inputs.self; }
        ]
        ++ files;
      };
    in
    {
      packages.x86_64-linux.write-files = e.config.files.writer.drv;
      checks.x86_64-linux = e.config.files.checks;
    };

  yen.aspects.files-inputs = {
    at = yen.fleet.vix;
    flake-file.inputs.files.url = "github:sini/files";
  };
}
