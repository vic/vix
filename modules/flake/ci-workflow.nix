# CI workflow: .github/workflows/ci.yml from the `jobs` sink. Aspects give the jobs: the build jobs (one matrix job per runner, from the
# `ci-jobs` sink and the checks), the generated-files job and the yen gate. github.workflow writes the file.
{ yen, ... }:
let
  inherit (yen.lib.batteries) cachix files github;
  # the runner label of a system, from the fleet `runners` sink (flake/ci.nix)
  runnerOf = runners: system: runners.${system}.label;
  # generated files (README, ci.yml) are checked on every PR event, so they are never stale
  isFiles = j: builtins.match "check-files/.*" j.name != null;
  setup = [
    {
      uses = "actions/checkout@v6";
    }
    {
      uses = "DeterminateSystems/determinate-nix-action@v3";
    }
    {
      uses = "DeterminateSystems/magic-nix-cache-action@v13";
    }
    (cachix.action { name = "vix"; })
  ];
  # the runner quota is small: PRs build only once approved or labeled `ci` (an author cannot approve their own PR)
  gate = builtins.concatStringsSep " || " [
    "github.event_name == 'push'"
    "github.event_name == 'workflow_dispatch'"
    "github.event.review.state == 'approved'"
    "github.event.label.name == 'ci'"
    "(github.event.action == 'synchronize' && contains(github.event.pull_request.labels.*.name, 'ci'))"
  ];
  job = cond: runner: include: {
    name = "build \${{ matrix.name }}";
    "if" = cond;
    runs-on = runner;
    continue-on-error = "\${{ matrix.allowFailure }}";
    strategy = {
      fail-fast = false;
      matrix.include = include;
    };
    steps =
      (
        if runner == "ubuntu-latest" then
          [
            { uses = "wimpysworld/nothing-but-nix@v10"; }
          ]
        else
          [ ]
      )
      ++ setup
      ++ [
        { run = "nix build --print-build-logs --out-link result '.#\${{ matrix.attr }}'"; }
        { run = "echo \"<code>$(readlink -f result)</code>\" >> \"$GITHUB_STEP_SUMMARY\""; }
      ];
  };
  # every check of the flake, as a matrix entry
  checksOf =
    runners: out:
    builtins.concatLists (
      builtins.attrValues (
        builtins.mapAttrs (
          system: cs:
          map (n: {
            name = "check-${n}-${system}";
            attr = "checks.${system}.\"${n}\"";
            inherit system;
            runner = runnerOf runners system;
            allowFailure = false;
          }) (builtins.attrNames cs)
        ) (builtins.intersectAttrs runners out.checks) # the checks of systems that have a runner
      )
    );
in
{
  yen.kinds.fleet.sinks.jobs = {
    reduce = yen.lib.reduce.merge;
    files = github.workflow {
      from = yen.kinds.fleet.sinks.jobs;
      path = ".github/workflows/ci.yml";
      doc = {
        name = "ci";
        on = {
          workflow_dispatch = { };
          pull_request.types = [
            "opened"
            "reopened"
            "labeled"
            "synchronize"
          ];
          pull_request_review.types = [ "submitted" ];
          push.branches = [ "yen" ];
        };
        concurrency = {
          group = "\${{ github.workflow }}-\${{ github.ref }}";
          cancel-in-progress = true;
        };
        permissions.contents = "read";
      };
      header =
        _: files.comment "ci.yml" "generated by modules/flake/ci-workflow.nix: nix run .#write-files";
    };
  };

  # the builds, gated: one job per runner
  yen.aspects.ci-builds = {
    at = yen.kinds.fleet;
    jobs =
      { out, runners, ... }:
      builtins.listToAttrs (
        builtins.attrValues (
          builtins.mapAttrs
            (r: include: {
              name = "build-${builtins.replaceStrings [ "." ] [ "_" ] r}";
              value = job gate r include;
            })
            (
              builtins.groupBy (j: j.runner) (
                out.ci.matrix ++ builtins.filter (j: !isFiles j) (checksOf runners out)
              )
            )
        )
      );
  };
  # the generated files are checked on every event
  yen.aspects.ci-files = {
    at = yen.kinds.fleet;
    jobs =
      { out, runners, ... }:
      {
        build-files = job "true" (runnerOf runners "x86_64-linux") (
          builtins.filter isFiles (checksOf runners out)
        );
      };
  };
  # yen gate: one eval, so every PR event runs it: no error records, invariants ok, no undefined aspect
  yen.aspects.ci-yen-gate = {
    at = yen.kinds.fleet;
    jobs = { runners, ... }: {
      yen-gate = {
        name = "yen gate";
        runs-on = runnerOf runners "x86_64-linux";
        steps = setup ++ [
          {
            run = builtins.concatStringsSep "\n" [
              "test \"$(nix eval --impure --json --file query.nix errors)\" = '[]'"
              "test \"$(nix eval --impure --json --file query.nix check.ok)\" = 'true'"
              "test \"$(nix eval --impure --json --file query.nix undefined)\" = '[]'"
            ];
          }
        ];
      };
    };
  };
}
