# CI workflow: `.github/workflows/ci.yml` emitted to `files` sink from root `jobs`.
{
  yen,
  reduce,
  ...
}:
let
  runnerOf = runners: system: runners.${system}.label;
  isFiles = j: builtins.match "check-files/.*" j.name != null;
  setup = [
    { uses = "actions/checkout@v6"; }
    { uses = "DeterminateSystems/determinate-nix-action@v3"; }
    { uses = "DeterminateSystems/magic-nix-cache-action@v13"; }
    {
      uses = "cachix/cachix-action@v16";
      "with" = {
        name = "vix";
        authToken = "\${{ secrets.CACHIX_AUTH_TOKEN }}";
      };
    }
  ];
  gate = builtins.concatStringsSep " || " [
    "github.event_name == 'push'"
    "github.event_name == 'workflow_dispatch'"
    "github.event.review.state == 'approved'"
    "github.event.label.name == 'ci'"
    "(github.event.action == 'synchronize' && contains(github.event.pull_request.labels.*.name, 'ci'))"
  ];
  job = cond: runner: include: {
    name = "build \${{ matrix.name }}";
    "if" = cond;
    runs-on = runner;
    continue-on-error = "\${{ matrix.allowFailure }}";
    strategy = {
      fail-fast = false;
      matrix.include = include;
    };
    steps =
      (if runner == "ubuntu-latest" then [ { uses = "wimpysworld/nothing-but-nix@v10"; } ] else [ ])
      ++ setup
      ++ [
        { run = "nix build --print-build-logs --out-link result '.#\${{ matrix.attr }}'"; }
        { run = "echo \"<code>$(readlink -f result)</code>\" >> \"$GITHUB_STEP_SUMMARY\""; }
      ];
  };
  checksOf =
    runners: out:
    builtins.concatLists (
      builtins.attrValues (
        builtins.mapAttrs (
          system: cs:
          map (n: {
            name = "check-${n}-${system}";
            attr = "checks.${system}.\"${n}\"";
            inherit system;
            runner = runnerOf runners system;
            allowFailure = false;
          }) (builtins.attrNames cs)
        ) (builtins.intersectAttrs runners (out.checks or { }))
      )
    );
in
{
  yen.kinds.root.sinks.jobs = {
    reduce = reduce.merge;
    into.files =
      { jobs, ... }:
      {
        files.file.".github/workflows/ci.yml".text =
          "# generated by modules/flake/ci-workflow.nix: nix run .#write-files\n"
          + builtins.toJSON {
            name = "ci";
            on = {
              workflow_dispatch = { };
              pull_request.types = [
                "opened"
                "reopened"
                "labeled"
                "synchronize"
              ];
              pull_request_review.types = [ "submitted" ];
              push.branches = [ "yen" ];
            };
            concurrency = {
              group = "\${{ github.workflow }}-\${{ github.ref }}";
              cancel-in-progress = true;
            };
            permissions.contents = "read";
            inherit jobs;
          };
      };
  };

  yen.aspects.ci-builds = {
    at = yen.root;
    jobs =
      { out, runners, ... }:
      builtins.listToAttrs (
        builtins.attrValues (
          builtins.mapAttrs
            (r: include: {
              name = "build-${builtins.replaceStrings [ "." ] [ "_" ] r}";
              value = job gate r include;
            })
            (
              builtins.groupBy (j: j.runner) (
                (out.ci.matrix or [ ]) ++ builtins.filter (j: !isFiles j) (checksOf runners out)
              )
            )
        )
      );
  };

  yen.aspects.ci-files = {
    at = yen.root;
    jobs =
      { out, runners, ... }:
      {
        build-files = job "true" (runnerOf runners "x86_64-linux") (
          builtins.filter isFiles (checksOf runners out)
        );
      };
  };

  yen.aspects.ci-yen-gate = {
    at = yen.root;
    jobs =
      { runners, ... }:
      {
        yen-gate = {
          name = "yen gate";
          runs-on = runnerOf runners "x86_64-linux";
          steps = setup ++ [
            {
              run = builtins.concatStringsSep "\n" [
                "test \"$(nix eval .#yen.ok)\" = 'true'"
                "test \"$(nix eval --json .#yen.errors)\" = '[]'"
                "test \"$(nix eval --json .#yen.check.violations)\" = '[]'"
                "test \"$(nix eval --json .#yen.undefined)\" = '[]'"
              ];
            }
          ];
        };
      };
  };
}
