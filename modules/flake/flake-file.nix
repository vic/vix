# flake-file: aspects declare inputs on the root `flake-file` sink (zero `import-tree`!).
{
  yen,
  reduce,
  lib,
  inputs,
  ...
}:
let
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
  evalFlakeFile =
    flake-file:
    lib.evalModules {
      specialArgs = { inherit inputs; };
      modules = [
        inputs.flake-file.flakeModules.flake
        { inherit flake-file; }
      ];
    };
in
{
  yen.kinds.root.sinks.flake-file = {
    reduce = reduce.merge;
    into.out =
      { flake-file, ... }:
      (e: {
        packages.x86_64-linux = {
          write-flake = e.config.flake-file.apps.write-flake pkgs;
          write-lock = e.config.flake-file.apps.write-lock pkgs;
        };
        checks.x86_64-linux.flake-file = e.config.flake-file.check-flake-file pkgs;
      })
        (evalFlakeFile flake-file);
  };

  yen.aspects.vix-flake = {
    at = yen.root;
    flake-file = {
      description = "Vic's Nix Environment, powered by yen";
      outputs = ''
        inputs:
        inputs.yen.mkFlake {
          inherit inputs;
          inherit (inputs.nixpkgs) lib;
        } ./modules
      '';
      do-not-edit = ''
        # DO-NOT-EDIT. Generated by github:vic/flake-file from the `flake-file` sink of modules/.
        # Regenerate: nix build .#write-flake && ./result/bin/write-flake
      '';
      inputs = {
        yen.url = "github:vic/yen";
        flake-file.url = "github:vic/flake-file";
      };
    };
  };
}
