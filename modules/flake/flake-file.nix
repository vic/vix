# flake-file: each aspect declares the inputs it uses on the `flake-file` sink. The flake-file.write battery gives
# write-flake (writes flake.nix) and the check that the committed flake.nix matches; write-lock comes from the same module.
{
  yen,
  lib,
  inputs,
  ...
}:
let
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
  from = yen.kinds.fleet.sinks.flake-file;
  write = yen.lib.batteries.flake-file.write {
    inherit
      from
      lib
      inputs
      pkgs
      ;
  };
  # write-lock: flake.lock from the same inputs (the battery gives write-flake only)
  lockOf =
    { sinks, ... }:
    (lib.evalModules {
      specialArgs = { inherit inputs; };
      modules = [
        inputs.flake-file.flakeModules.flake
        { flake-file = sinks.${from.__sink}; }
      ];
    }).config.flake-file.apps.write-lock
      pkgs;
in
{
  # on the root: an aspect at any scope reaches it
  yen.kinds.fleet.sinks.flake-file = {
    reduce = yen.lib.reduce.merge;
    out =
      { scope, sinks, ... }@args:
      lib.recursiveUpdate (write args) { packages.x86_64-linux.write-lock = lockOf args; };
  };

  yen.aspects.vix-flake = {
    at = yen.fleet.vix;
    flake-file = {
      description = "Vic's Nix Environment, powered by yen";
      # nixConfig: the fleet `caches` sink (nix/settings.nix)
      outputs = ''
        inputs:
        (import inputs.yen).lib.mkFlake {
          inherit inputs;
          inherit (inputs.nixpkgs) lib;
        } (inputs.import-tree ./modules)
      '';
      do-not-edit = ''
        # DO-NOT-EDIT. Generated by github:vic/flake-file from the `flake-file` sink of modules/.
        # Regenerate: nix build .#write-flake && ./result/bin/write-flake
      '';
      inputs = {
        yen = {
          url = "github:vic/yen";
          flake = false;
        };
        import-tree.url = "github:vic/import-tree";
        flake-file.url = "github:vic/flake-file";
      };
    };
  };
}
