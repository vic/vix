# flake-file: each aspect declares the inputs it uses on the `flake-file` sink; write-flake writes flake.nix from them.
{ yen, inputs, ... }:
let
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
in
{
  # on the root: an aspect at any scope reaches it
  yen.kinds.fleet.sinks.flake-file = {
    reduce = yen.lib.reduce.merge;
    out =
      { flake-file, ... }:
      let
        e = inputs.nixpkgs.lib.evalModules {
          specialArgs = { inherit inputs; }; # write-flake.nix reads `top.inputs.self`: only specialArgs reach `@top`
          modules = [
            inputs.flake-file.flakeModules.flake
            { inherit flake-file; }
          ];
        };
        app = n: e.config.flake-file.apps.${n} pkgs;
      in
      {
        packages.x86_64-linux = {
          write-flake = app "write-flake";
          write-lock = app "write-lock";
        };
        checks.x86_64-linux.flake-file = e.config.flake-file.check-flake-file pkgs;
      };
  };

  yen.aspects.vix-flake = {
    at = yen.fleet.vix;
    flake-file = {
      description = "Vic's Nix Environment, powered by yen";
      nixConfig = {
        extra-trusted-public-keys = [ "vix.cachix.org-1:hP/Lpdsi1dB3AxK9o6coWh+xHzvAc4ztdDYuG7lC6dI=" ];
        extra-substituters = [ "https://vix.cachix.org" ];
      };
      outputs = ''
        inputs:
        (import inputs.yen).lib.mkFlake {
          imports = [ (inputs.import-tree ./modules) ];
          _module.args = {
            inherit inputs;
            inherit (inputs.nixpkgs) lib;
          };
        }
      '';
      do-not-edit = ''
        # DO-NOT-EDIT. Generated by github:vic/flake-file from the `flake-file` sink of modules/.
        # Regenerate: nix build .#write-flake && ./result/bin/write-flake
      '';
      inputs = {
        yen = {
          url = "github:vic/yen";
          flake = false;
        };
        import-tree.url = "github:vic/import-tree";
        flake-file.url = "github:vic/flake-file";
      };
    };
  };
}
